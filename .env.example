# Copy to .env (never commit .env). Every value is optional: defaults point inside this repo.
# Change a value here only when you move to a different environment/machine.

# --- Keys ---
NEXABOT_API_KEY=
# NEXABOT_KEY_FILE=vendor/Motion_as_kit/.env.nexabot

# ChatGPT text (tools/llm.py, codex)
OPENAI_API_KEY=
# ChatGPT images (codex-image/openai_image.py, IMAGE_BACKEND=openai)
OPENAI_IMAGE_API_KEY=
# Claude via Sub2API (tools/llm.py fallback, codex --profile claude, tools/claude-sub2api.sh)
SUB2API_API_KEY=
# LLM_MODEL=auto            # auto | gpt | claude | <model id>
# LLM_GPT_MODELS=gpt-5.5,gpt-5.6
# LLM_CLAUDE_MODELS=claude-sonnet-4-6,claude-haiku-4-5
# OPENAI_BASE_URL=https://space.stationine.com/v1
# IMAGE_MODEL=gpt-image-1.5
# IMAGE_QUALITY=high

# --- External kits (default locations inside this repo) ---
# NEXABOT_TS=vendor/Motion_as_kit/nexabot/nexabot.ts
# MOTION_KIT=vendor/Motion_as_kit
# VIDEO3D_KIT=vendor/video-3d-kit

# --- Output / media ---
# RUNS_DIR=runs
# MOTION_VIDEOS_DIR=runs/motion-videos
# MUSIC_DIR=assets/music

# --- Fonts (auto-detected on Windows/macOS/Linux; set to force one) ---
# FONT_BOLD=
# FONT_IMPACT=

# --- vox ---
# VOX_PROJECT_ROOT=
# VOX_SKILL=.claude/skills/vox-video-nexabot/SKILL.md
# IMAGE_BACKEND=openai    # openai (default) | nexabot | codex
# IMAGE_FALLBACK=nexabot   # nexabot | none
