# Copy to .env (never commit .env). Every value is optional: defaults point inside this repo.
# Change a value here only when you move to a different environment/machine.

# --- Keys ---
NEXABOT_API_KEY=
# NEXABOT_KEY_FILE=vendor/Motion_as_kit/.env.nexabot

# --- External kits (default locations inside this repo) ---
# NEXABOT_TS=vendor/Motion_as_kit/nexabot/nexabot.ts
# MOTION_KIT=vendor/Motion_as_kit
# VIDEO3D_KIT=vendor/video-3d-kit

# --- Output / media ---
# RUNS_DIR=runs
# MOTION_VIDEOS_DIR=runs/motion-videos
# MUSIC_DIR=assets/music

# --- Fonts (auto-detected on Windows/macOS/Linux; set to force one) ---
# FONT_BOLD=
# FONT_IMPACT=

# --- vox ---
# VOX_PROJECT_ROOT=
# VOX_SKILL=.claude/skills/vox-video-nexabot/SKILL.md
# IMAGE_BACKEND=nexabot
